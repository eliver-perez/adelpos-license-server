[Unit]
Description=AD-EL POS license server: session cleanup, audit anchor and encrypted backup
After=mysql.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/flock -n /srv/adelpos-license/backup/maintenance.lock /usr/local/sbin/adelpos-license-maintenance
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/adelpos-license/backup
